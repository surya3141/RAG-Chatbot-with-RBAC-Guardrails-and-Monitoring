# LLM Provider
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# Embeddings (local HuggingFace model, no key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector DB
CHROMA_PERSIST_DIR=./chroma_db

# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=rag-chatbot-rbac

# Token cost alert threshold (USD)
TOKEN_COST_ALERT_THRESHOLD=1.0

# Data directory
DATA_DIR=./data
